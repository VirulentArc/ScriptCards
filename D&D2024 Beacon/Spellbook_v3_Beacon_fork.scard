  --]|[
    --~SBMBefore|string;before;[&SBMEntryKey];[&SBMRaw]
    --~SBMAfterKey|string;after;[&SBMEntryKey];[&SBMRaw]
    --~SBMAfterValue|string;after;[&SBMEntryEnd];[&SBMAfterKey]
    --&SBMRaw|[&SBMBefore][&SBMEntryKey][&SBMEntryValue][&SBMAfterValue]
  --]|
  --!h:[&CacheHID]|notes:"[&SBMRaw]"
