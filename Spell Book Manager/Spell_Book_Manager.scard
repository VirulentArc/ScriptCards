--:AdjustWarlockSpellDice|Character ID;Spell row prefix;Spell field;Attack row ID;Attack field;Dice expression;HL die count;HL die type;Level delta
  --?"[&WhatDo]" -ne "MOVE"|<
  --?"[&ShouldAdjustWarlockDamage]" -ne "1"|<
