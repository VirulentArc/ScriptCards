  --?"[&TransferSpellHealing]" -ne "" -and "[&TransferSpellHealing]" -ne "undefined" -and "[&TransferSpellHealing]" -ne "[&NoRow]"|&TransferSpellPrimaryDice;[&TransferSpellHealing]
  -->AdjustWarlockSpellDice|[&CharID];[&TransferSpellDestRowPrefix];[&TransferSpellPrimaryField];[&TransferSpellAttackID];dmgbase;[&TransferSpellPrimaryDice];[&TransferSpellHLDie];[&TransferSpellHLDieType];[$MovedLevelDelta.Raw]
  -->AdjustWarlockSpellDice|[&CharID];[&TransferSpellDestRowPrefix];spelldamage2;[&TransferSpellAttackID];dmg2base;[&TransferSpellDamage2];[&TransferSpellHLDie];[&TransferSpellHLDieType];[$MovedLevelDelta.Raw]
  --:AfterTransferSpellWarlockAdjust|
  --:AfterTransferSpellAttackRefresh|
  --?"[&TransferSpellOutput]" -ne "ATTACK" -and "[&TransferSpellHigherLevels]" -ne ""|[
    --!a:[&CharID]|[&TransferSpellDestRowPrefix]spellathigherlevels:
    --!a:[&CharID]|[&TransferSpellDestRowPrefix]spellathigherlevels:[&TransferSpellHigherLevels]
