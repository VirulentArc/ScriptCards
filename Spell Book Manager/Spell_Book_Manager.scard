  --?[$AdjustedWriteDiceRoll.Raw] -lt 0|=AdjustedWriteDiceRoll;0
  --&AdjustedWriteDice|[$AdjustedWriteDiceRoll.Raw][%8%]
  --!a:[%1%]|[%2%][%3%]:[&AdjustedWriteDice]
  --?"[%4%]" -eq "" -or "[%4%]" -eq "undefined" -or "[%4%]" -eq "[&NoRow]"|<
