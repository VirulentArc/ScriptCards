  --&NSBWhisperIcon|&#128488;&#65038; --&NSBWhisperNext|1 --&NSBWhisperTitle|Toggle Whisper to GM On --?"[&NSBWhisper]" -eq "1"|[ --&NSBWhisperIcon|&#128483;&#65038; --&NSBWhisperNext|0 --&NSBWhisperTitle|Toggle Whisper to GM Off --]|
  --&NSBAutoDamageNext|full --&NSBAutoDamageTitle|Toggle Auto Damage Roll On --&NSBAutoDamageBorder|border-color:#FFEFD5; --?"[&NSBAutoDamage]" -eq "full"|[ --&NSBAutoDamageNext|pick --&NSBAutoDamageTitle|Toggle Auto Damage Roll Off --&NSBAutoDamageBorder|border-color:#7A2008; --]|
  --&NSBBtnDBorder|border-color:#FFEFD5; --&NSBBtnNBorder|border-color:#FFEFD5; --&NSBBtnABorder|border-color:#FFEFD5;
