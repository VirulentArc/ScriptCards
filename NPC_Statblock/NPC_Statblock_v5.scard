  --&NSBBtnCellStyle|[&ButtonStyle] text-align:center; width:18px; min-width:18px; max-width:18px; height:15px; line-height:15px; vertical-align:middle; background-color:#FFEFD5; color:#7A2008; font-family:'Segoe UI Symbol','Noto Sans Symbols 2','Noto Sans Symbols','DejaVu Sans',sans-serif; padding:0;
  --&NSBSpacerCellStyle|width:6px; min-width:6px; max-width:6px; padding:0; border:none; background-color:transparent; font-size:1px; line-height:1px;
  --&NSBTitleControls|[t style="border-collapse:separate; border-spacing:0; table-layout:fixed; margin-left:auto;"][tr][td title="[&NSBWhisperTitle]" style="[&NSBBtnCellStyle]"][rbutton:#7A2008:#FFEFD5:11px][F::12][&NSBWhisperIcon][/F]::SetNSBOption;whisper!@![&NSBWhisperNext][/rbutton][/td][td style="[&NSBSpacerCellStyle]"]&nbsp;[/td][td title="Disadvantage" style="[&NSBBtnCellStyle] border:[&NSBBtnDBorder];"][rbutton:#7A2008:#FFEFD5:11px][F:Tahoma:11]D[/F]::SetNSBOption;advantage!@!disadvantage[/rbutton][/td][td title="Normal Roll" style="[&NSBBtnCellStyle] border:[&NSBBtnNBorder];"][rbutton:#7A2008:#FFEFD5:11px][F:Tahoma:11]N[/F]::SetNSBOption;advantage!@!normal[/rbutton][/td][td title="Advantage" style="[&NSBBtnCellStyle] border:[&NSBBtnABorder];"][rbutton:#7A2008:#FFEFD5:11px][F:Tahoma:11]A[/F]::SetNSBOption;advantage!@!advantage[/rbutton][/td][td style="[&NSBSpacerCellStyle]"]&nbsp;[/td][td title="Classic Roll" style="[&NSBBtnCellStyle] border:[&NSBBtnCBorder];"][rbutton:#7A2008:#FFEFD5:11px][F:Tahoma:11]C[/F]::SetNSBOption;advantage!@!classic[/rbutton][/td][/tr][/t]
