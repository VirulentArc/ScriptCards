  --&ActionPairRightCellStyle|style="[&ActionPairLiveBase]padding:0 0 0 3px;text-align:right;"
  --&ActionPairOddBlankCellStyle|style="width:50%;padding:0;"
  --&ActionNameOpenBase|[b][i]
