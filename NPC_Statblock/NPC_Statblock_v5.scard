--:BuildNSBSkillGrid|Mode
  --&SkillGridMode|[%1%] --&AddSkill| --&SkillOutput| --&HasSkills|0
  --?"[&Beacon]" -eq "1"|[ --&HasSkills|[*S:npc_skills_flag:::0] --]|[ -->GetClassicAttribute|[&CharID];npc_skills_flag;0 --&HasSkills|[&ClassicAttributeValue] --]|
