  --?"[&NSBCrit1]" -ne "" -and "[&NSBCrit1]" -ne "undefined"|[ --&NSBDamageBlock|+ !OB!!OB!crit1=!LB!!LB![&NSBCrit1]!RB!!RB!!CB!!CB! --]|
  --?"[&NSBDamage2]" -ne "" -and "[&NSBDamage2]" -ne "undefined"|[ --&NSBDamageBlock|+ !OB!!OB!dmg2flag=1!CB!!CB! !OB!!OB!dmg2=!LB!!LB![&NSBDamage2]!RB!!RB!!CB!!CB! !OB!!OB!dmg2type=[&NSBDamageType2]!CB!!CB! --]|
  --?"[&NSBCrit2]" -ne "" -and "[&NSBCrit2]" -ne "undefined"|[ --&NSBDamageBlock|+ !OB!!OB!crit2=!LB!!LB![&NSBCrit2]!RB!!RB!!CB!!CB! --]|
