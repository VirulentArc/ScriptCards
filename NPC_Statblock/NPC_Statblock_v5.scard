    --~SkillInfo|string;split;!@!;[&SkillLoop]
    --&RawSkill|[&SkillInfo1] --&SkillLabel|[&SkillInfo2] --&SkillButtonLabel|[&SkillInfo3] --&SkillMod|[&SkillInfo4] --&NSBSkillTag|[&SkillInfo5]
