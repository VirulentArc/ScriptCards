  --&InfoValue|[*S:npc_challenge] --?"[&InfoValue(length)]" -gt "0"|[ --&FourthBlock|+[tr][td][b]Challenge[/b]&nbsp;[&InfoValue]&nbsp;([*S:npc_xp]xp)[/td][/tr] --]|
  --&InfoValue|[*S:pb] --?"[&InfoValue]" -ne "0" -and "[&InfoValue(length)]" -gt "0"|[ --&FourthBlock|+[tr][td][b]Proficiency Bonus[/b]&nbsp;&#43;[&InfoValue][/td][/tr] --]|
