  --C[&NSBStats]|show:&NSBStatsIcon;[&NSBIconMinus] --C[&NSBTraits]|show:&NSBTraitsIcon;[&NSBIconMinus] --C[&NSBBasics]|show:&NSBBasicsIcon;[&NSBIconMinus]
  --C[&NSBAbilities]|show:&NSBAbilitiesIcon;[&NSBIconMinus] --C[&NSBSkills]|show:&NSBSkillsIcon;[&NSBIconMinus]
