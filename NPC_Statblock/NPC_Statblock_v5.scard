  --:NoLinkedCharacter| --#title|NPC Stat Block --+No Character Sheet|[*S:t-name] is not linked to a character sheet. Please select a token that represents an NPC character. --X|
  --:NotNPC| --#title|NPC Stat Block --+Wrong Token Type|[*S:t-name] is not an NPC character. Please select an NPC token to continue. --X|
  --:NoSelectedToken| --#title|NPC Stat Block --+No Token Selected|Please select an NPC token to continue. --X|
