  --?"[&NSBAbilities]" -ne "show" -and "[&NSBHasSaves]" -eq ""|SkipNSBAbilityBuild
  --~|array;define;StatArray;strength;dexterity;constitution;intelligence;wisdom;charisma
  --&StatsBlock|[t style="width:100%;table-layout:fixed;text-align:center;border-collapse:separate;border-spacing:0 2px;"]
  --&StatsCheckRow|[tr] --&StatsSaveRow|[tr]
  --%StatLoop|foreach;StatArray
    --&SaveButton|[&StatLoop(0,3)]
    --=ThisMod|[*S:[&StatLoop]_mod]
    --C[&StatLoop]|strength:&NSBStrMod;[$ThisMod.Raw]|dexterity:&NSBDexMod;[$ThisMod.Raw]|intelligence:&NSBIntMod;[$ThisMod.Raw]|wisdom:&NSBWisMod;[$ThisMod.Raw]|charisma:&NSBChaMod;[$ThisMod.Raw]
    --&SaveMod|[$ThisMod.Raw]
    --?"[&NSBHasSaves]" -eq ""|NSBSkipListedSave
    --&SaveFlag|[*S:npc_[&SaveButton]_save_flag]
    --?"[&SaveFlag]" -eq "0"|NSBSkipListedSave
    --&SaveRaw|[*S:npc_[&SaveButton]_save]
    --~SaveRaw|string;numericonly;[&SaveRaw]
    --?"[&SaveRaw]" -eq ""|NSBSkipListedSave
    --&SaveMod|[&SaveRaw]
    --?"[&NSBStats]" -eq "show"|[
      --&SaveDisplay|&#43;[&SaveMod]
      --?"[&SaveMod]" -lt "0"|[ --=AbsSave|[&SaveMod] {ABS} --&SaveDisplay|&minus;[$AbsSave.Raw] --]|
      --&AddSave|+[&SaveButton(totitlecase)]&nbsp;[&SaveDisplay],&nbsp;
    --]|
    --:NSBSkipListedSave|
    --?"[&NSBAbilities]" -ne "show"|NSBSkipAbilityButtonBuild
    --&StatName|[&SaveButton(touppercase)]
    --?"[= [&StatsCounter] % 3 ]" -eq "0" -and "[&StatsCounter]" -ne "0"|[ --&StatsBlock|+[&StatsCheckRow][/tr][&StatsSaveRow][/tr] --&StatsCheckRow|[tr] --&StatsSaveRow|[tr] --]|
    --&StatSpace|
    --&StatNum|[*S:[&StatLoop]]
    --&ModPart|&#43;[$ThisMod.Raw]
    --?[$ThisMod.Raw] -lt 0|[ --=AbsMod|[$ThisMod.Raw] {ABS} --&ModPart|&minus;[$AbsMod.Raw] --]|
    --?"[&StatNum]" -lt "10"|[ --&StatSpace|&nbsp; --]|
    --&NSBStatCheckButton|[rbutton:14PX][&StatName]&nbsp;[&StatNum][&StatSpace]&nbsp;([&ModPart])::NSBRunRoll;[&StatName] Check!@![$ThisMod.Raw]!@!ability!@![&StatLoop]!@![&StatName][/rbutton]
    --&NSBStatSaveButton|[rbutton]save::NSBRunRoll;[&StatName] Save!@![&SaveMod]!@!save!@![&StatLoop]!@![&StatName][/rbutton]
    --&StatsCheckRow|+[td style="[&ButtonChrome]padding:0 2px;text-align:center;vertical-align:middle;font-weight:bold;overflow:hidden;"][&NSBStatCheckButton][/td]
    --&StatsSaveRow|+[td [&CenterButtonCell]][&NSBStatSaveButton][/td]
    --&StatsCounter|[= [&StatsCounter] + 1 ]
    --:NSBSkipAbilityButtonBuild|
  --%|
