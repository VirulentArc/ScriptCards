  --#functionbenchmarking|1
  --#Debug|1 --#Whisper|self --#emoteState|0 --#dontcheckbuttonsforapi|1 --#title|
  --?"[@SC_SelectedTokens()]" -eq "undefined array"|NoSelectedToken
  --?"[@SC_SelectedTokens()]" -gt "1"|MultipleSelectedTokens
  --&TokenID|[@SC_SelectedTokens(0)]
  --#sourceToken|[&TokenID] --#reentrant|NPCBlock- [&TokenID]
  --&TokenRepresents|[*S:t-represents] --&TokenName|[*S:t-name] --&SourceNPCFlag|[*S:npc]
  --?"[&TokenRepresents]" -eq "" -or "[&TokenRepresents]" -eq "undefined"|NoLinkedCharacter
  --?"[&SourceNPCFlag]" -ne "1"|NotNPC|Continue
  --:NoLinkedCharacter| --#title|NPC Stat Block --+No Character Sheet|[&TokenName] is not linked to a character sheet. Please select a token that represents an NPC character. --X|
  --:NotNPC| --#title|NPC Stat Block --+Wrong Token Type|[&TokenName] is not an NPC character. Please select an NPC token to continue. --X|
  --:NoSelectedToken| --#title|NPC Stat Block --+No Token Selected|Please select an NPC token to continue. --X|
  --:MultipleSelectedTokens| --#title|NPC Stat Block --+Multiple Tokens Selected|Please select only one NPC token to continue. --X|
  --:Continue| --#title| --#hidetitlecard|1 --#tableborder|0 --#tablebgcolor|transparent --#tableshadow|none --#tableborderradius|0px --#oddrowbackground|transparent --#evenrowbackground|transparent --#oddrowfontcolor|#000000 --#evenrowfontcolor|#000000 --#bodyfontface|serif --#bodyfontsize|12px --#lineheight|normal --#buttonbackground|transparent --#buttontextcolor|#7A2008 --#buttonbordercolor|transparent --#buttonpadding|2px --#buttonfontface|inherit --#buttonfontsize|inherit --#buttonwidth|auto
  --&CharID|[*S:character_id] --&CharName|[*S:character_name]
  -->LoadNSBSettings|
  --:NSBRebuildFromCurrentSettings| --#hidecard|0
  --&NPC_Name|[*S:npc_name] --&SAB|[*S:spell_attack_bonus] --&NPCActypeRaw|[*S:npc_actype] --&BaseHPRaw|[*S:hp] --&NPCactype| --&BaseHP|
  --?"[&NPCActypeRaw]" -ne ""|[ --&NPCactype|([&NPCActypeRaw]) --]|
  --?"[&BaseHPRaw]" -ne ""|[ --&BaseHP| [&BaseHPRaw] / --]|
  --&ButtonChrome|white-space:nowrap;background:#FFEFD5;color:#7A2008;border-radius:4px;box-shadow:0 1px 2px rgba(0,0,0,.3),inset 0 1px 1px rgba(0,0,0,.1),inset 0 -1px 1px rgba(0,0,0,.1);
  --&ButtonStyle|width:1%;[&ButtonChrome]padding:0 4px;
  --&CSSCollapse|border-collapse:collapse;border-spacing:0;
  --&CSSFixed|border-collapse:collapse;table-layout:fixed;
  --&CSSClearCell|padding:0;border:0;background:none;
  --&CSSSymbolFont|font-family:'Segoe UI Symbol','Noto Sans Symbols 2','Noto Sans Symbols','DejaVu Sans',sans-serif;
  --&ClipTextBase|white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:#000;
  --&W0|width:0;min-width:0;max-width:0; --&W6|width:6px; --&W15|width:15px;
  --&W18|width:18px; --&W22|width:22px; --&W28|width:28px;
  --&W50|width:50px; --&W122|width:122px;
  --&ButtonCellCore|[&ButtonChrome]text-align:center;vertical-align:middle;padding:0;
  --&NSBDividerLineCell|border:0;border-top:.10em solid transparent;border-bottom:.25em solid transparent;border-left:16em solid #910900;line-height:1.25em;font-size:1.4em;display:block;padding:0;background:transparent;
  --&HRStyle|style="border-bottom:2px solid #7A2008;padding-bottom:2px;letter-spacing:.8px;text-shadow:.6px 0 0 currentColor;"
  --&InfoCellStyle|style="width:260px;display:block;"
  --&ClipCellStyle|style="width:90%;max-width:0;[&ClipTextBase]"
