  --&ButtonGridStyle|style="width:100%;border-collapse:separate;border-spacing:0 2px;" --&CenterButtonCell|style="[&ButtonStyle]text-align:center;vertical-align:middle;"
  --&SpellButtonCell|style="[&ButtonCellCore][&W18]height:16px;line-height:16px;"
  --&RuleSpacer|[tr][td style="line-height:4px"]&nbsp;[/td][/tr] --&TightRuleSpacer|[tr][td style="line-height:2px"]&nbsp;[/td][/tr]
  --&NPCNameFontSize|24px --&NPCNameWhiteSpace|nowrap
  --?"[&NPC_Name(length)]" -gt "18"|[ --&NPCNameFontSize|22px --]|
  --?"[&NPC_Name(length)]" -gt "22"|[ --&NPCNameFontSize|20px --]|
  --?"[&NPC_Name(length)]" -gt "26"|[ --&NPCNameFontSize|16px --&NPCNameWhiteSpace|normal --]|
