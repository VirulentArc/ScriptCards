  --&NSBCardOpen|[t style='width:300px;table-layout:fixed;position:relative;left:-30px;border:0;border-collapse:separate;border-spacing:0;background-color:#264C5E;background-image:url(https://files.d20.io/images/105716505/oymO0pnVyLCv-tQDw2vddA/med.png);background-size:100% 100%;background-position:center;background-repeat:no-repeat;font-size:12px;line-height:1.2em;'][tr][td style='[&NSBRuleBase]border:1px solid #3d0d03;top:-6px;'][/td][/tr][tr][td style='border:0;padding:0 15px;background:transparent;color:#7A2008;font-family:"Segoe UI",Tahoma,sans-serif;']
  --&NSBCardClose|[/td][/tr][tr][td style='[&NSBRuleBase]border:1px solid #2f2112;bottom:-6px;'][/td][/tr][/t]
  --&NSBCardHTML|[&NSBCardOpen]
  --&NSBCardHTML|+[t style="width:100%;"][tr][td [&NPCNameStyle]][&NPC_Name][/td][/tr][/t]
  --&NSBCardHTML|+[t style="width:100%;"][tr][td style="color:#000;font-style:italic;"][*S:npc_type]&nbsp;[/td][/tr][tr][td][&NSBDividerOpen][&NSBCollapseBtnOpen][&NSBBasicsIcon][&NSBCollapseBtnMid]basics[&NSBCollapseBtnClose][&NSBDividerClose][/td][/tr][/t]
  --?"[&NSBBasics]" -eq "show"|[ --&NSBCardHTML|+[t style="width:100%;"][tr][td][b]Armor&nbsp;Class[/b]&nbsp;[*S:npc_ac]&nbsp;[&NPCactype][br][b]Hit&nbsp;Points[/b][&BaseHP]&nbsp;[*S:hp^]&nbsp;([*S:npc_hpformula])[br][b]Speed[/b]&nbsp;[*S:npc_speed][/td][/tr][/t] --]|
  --&NSBCardHTML|+[&NSBDividerOpen][&NSBCollapseBtnOpen][&NSBAbilitiesIcon][&NSBCollapseBtnMid]abilities[&NSBCollapseBtnClose][&NSBDividerClose]
  --?"[&NSBAbilities]" -ne "show" -and "[&NSBStats]" -ne "show"|SkipNSBAbilityBuild
