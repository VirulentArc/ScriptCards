  --&NSBRollFormula|[$NSBInitRoll1.Raw] + [&NSBModTerm]
  --&NSBModeBlock|!OB!!OB!normal=1!CB!!CB! !OB!!OB!r2=!LB!!LB!0d20 + [&NSBModTerm]!RB!!RB!!CB!!CB!
  --?"[&NSBAdvantage]" -ne "normal"|[
    --=NSBInitRoll2|1d20
