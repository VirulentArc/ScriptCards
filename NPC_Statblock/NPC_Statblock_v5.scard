    --C[&NSBAdvantage]|disadvantage:&NSBInitRollText;2d20kl1
    --C[&NSBAdvantage]|disadvantage:&NSBInitModeFlag;disadvantage
    --?"[&NSBAdvantage]" -eq "advantage" -and "[$NSBInitRoll2.Raw]" -gt "[$NSBInitRoll1.Raw]"|&NSBInitChosenDie;[$NSBInitRoll2.Raw]
    --?"[&NSBAdvantage]" -eq "disadvantage" -and "[$NSBInitRoll2.Raw]" -lt "[$NSBInitRoll1.Raw]"|&NSBInitChosenDie;[$NSBInitRoll2.Raw]
    --&NSBModeBlock|!OB!!OB![&NSBInitModeFlag]=1!CB!!CB! !OB!!OB!r2=!LB!!LB![$NSBInitRoll2.Raw] + [&NSBModTerm]!RB!!RB!!CB!!CB!
  --]|
