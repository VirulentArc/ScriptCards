  --&AbilityNameCell|width:13%;padding:2px 0 2px 4px;text-align:left;vertical-align:middle;border-bottom:1px solid [&AbilityBorderColor];font-weight:bold;
  --&AbilityScoreCell|width:8%;padding:2px 1px;text-align:center;vertical-align:middle;border-bottom:1px solid [&AbilityBorderColor];
