  --&NPC_senses|[*S:npc_senses]
  --&NPC_lang|[*S:npc_languages]
  --&NPC_chall|[*S:npc_challenge]
  --&NPC_pb|[*S:npc_pb]

  --&Divider|[t][tr][td height=5px][/td][/tr][/t][t][tr][td width=100% style="border: none; border-top: 0.10em solid transparent; border-bottom: 0.25em solid transparent; border-left: 14em solid #910900; line-height: 1.25em; font-size: 1.4em; display: block;"][/td][/tr][/t][t][tr][td height=5px][/td][/tr][/t]
  --&Space|[t][tr][td height=8px][/td][/tr][/t]

  --&HeaderBlock|[t width=100%][tr][td][F::12][#000][i][*S:npc_type]&nbsp;[/i][/#][/F][/td][/tr][tr][td][&Divider][/td][/tr][tr][td][F::12][b]Armor&nbsp;Class[/b]&nbsp;[*S:npc_ac]&nbsp;[&NPCactype][br][b]Hit&nbsp;Points[/b][&BaseHP]&nbsp;[*S:hp^]&nbsp;([*S:npc_hpformula])[br][b]Speed[/b]&nbsp;[*S:npc_speed][/F][/td][/tr][/t]
  --+|[&HeaderBlock]
  --+|[&Divider]
  --&StatsBlock|[t width=106% style="text-align: center; position: relative ; left: -6px"][tr][td width=80px][F::14][b][button]STR&nbsp;[*S:strength]&nbsp;([*S:strength_mod])::~selected|npc_str[/button]&nbsp;&#124;[/b][/F][br][button]save::~selected|npc_str_save[/button][/td][td width=80px][F::14][b][button]DEX&nbsp;[*S:dexterity]&nbsp;([*S:dexterity_mod])::~selected|npc_dex[/button]&nbsp;&#124;[/b][/F][br][button]save::~selected|npc_dex_save[/button][/td][td width=80px][F::14][b][button]CON&nbsp;[*S:constitution]&nbsp;([*S:constitution_mod])::~selected|npc_con[/button][/b][/F][br][button]save::~selected|npc_con_save[/button][/td][/tr][tr][td width=80px][F::14][b][button]INT&nbsp;[*S:intelligence]&nbsp;([*S:intelligence_mod])::~selected|npc_int[/button]&nbsp;&#124;[/b][/F][br][button]save::~selected|npc_int_save[/button][/td][td width=80px][F::14][b][button]WIS&nbsp;[*S:wisdom]&nbsp;([*S:wisdom_mod])::~selected|npc_wis[/button]&nbsp;&#124;[/b][/F][br][button]save::~selected|npc_wis_save[/button][/td][td width=80px][F::14][b][button]CHA&nbsp;[*S:charisma]&nbsp;([*S:charisma_mod])::~selected|npc_cha[/button][/b][/F][br][button]save::~selected|npc_cha_save[/button][/td][/tr][/t]
  --+|[&StatsBlock]
  --+|[&Divider]
