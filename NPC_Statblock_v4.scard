      --#parameterDelimiter|$$$
      --?"[&Action]" -eq "trait"|&ButtonEmote$$$&#128220;&#65038;|&ButtonEmote$$$&#x2694;
      --?"[&Action]" -eq "trait"|&ButtonSize$$$14|&ButtonSize$$$16
      --#parameterDelimiter|;
      --&Name|[*R:name]
