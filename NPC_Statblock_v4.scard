        --&ActionOutput|+[tr][td title="[&ToolTip]" style="width: 85%; max-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; color: #000; pointer-events: auto; cursor: help;"]&nbsp;[b][i][&Name].[/i][/b] [&Description][&AttDesc][/td][td style="width: 15%; text-align: right; white-space: nowrap;"][F::[&ButtonSize]][sheetbutton]|&nbsp;[&ButtonEmote]&nbsp;|::@{selected|character_name}::[&ButtonURL][/sheetbutton][/F][/td][/tr]
