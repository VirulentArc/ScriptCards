  --+|[t style="width: 100% ; text-align: center ; "][tr][td title="current sound message"][rbutton]Set Sound Message::SetAlertMessage;sound[/rbutton][/td][td title="current vibrate message"][rbutton]Set Vibrate Message::SetAlertMessage;vibrate[/rbutton][/td][td title="current none message"][rbutton]Set Silent Message::SetAlertMessage;silent[/rbutton][/td][/tr][/t]
  --+|[t style="width: 100% ; text-align: center ; "][tr][td title="Reset Sound Message"][rbutton]Reset::ResetVar;sound[/rbutton][/td][td title="Reset Vibrate Message"][rbutton]Reset::ResetVar;vibrate[/rbutton][/td][td title="Reset Silent Message"][rbutton]Reset::ResetVar;silent[/rbutton][/td][/tr][/t]
  --+|[t width=100%][tr][td][rbutton]Set Active Apps::SelectApps[/rbutton][/td][/tr][/t]
--X|
--:CharSettings|
  --&CommsID|[&reentryval]
  --:BacktoSettings|
  --&AlertMode|[*[&CommsID]:alertsound]
  --&Signal|[*[&CommsID]:signal]
  --&Comms|[*[&CommsID]:character_name]
  --&CommsName|[&Comms(replace,comms-,)]
  --#title|[&CommsName]'s Comm Settings
  --+|[rbutton]Back::GMPanel[/rbutton]
  --+|[rbutton]Assign Contacts::AssignContacts;[&CommsID][/rbutton]
  --~|array;define;AlertArray;sound;vibrate;silent
  --&AlertRow|[t style="width: 100% ; text-align: center ; "][tr]
  --%AMode|foreach;AlertArray
    --&BtnColor|
    --?"[&AMode]" -eq "[&AlertMode]"|[
       --&BtnColor|style="background-color:#228B22;"
    --]|
    --&AlertRow|+[td [&BtnColor]][rbutton][&AMode(totitlecase)]::SetAttr;[&AMode][/rbutton][/td]
  --%|
  --&AlertRow|+[/tr][/t]
  --+|[t style="width: 100% ; text-align: center ; font-weight: bold ; "][tr][td colspan=100%]Alert Mode[/td][/tr][/t]
  --+|[&AlertRow]
  --~|array;define;SigArray;strong;weak;none
  --&SigRow|[t style="width: 100% ; text-align: center ; "][tr]
  --%Strength|foreach;SigArray
    --&BtnColor|
    --?"[&Strength]" -eq "[&Signal]"|[
      --&BtnColor|style="background-color:#228B22;"
    --]|
    --&SigRow|+[td [&BtnColor]][rbutton][&Strength(totitlecase)]::SetAttr;[&Strength][/rbutton][/td]
