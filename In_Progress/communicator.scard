  --~|array;sort;NPCArray
  --+|[rbutton]back::BacktoSettings[/rbutton]
  --+|Player Contacts
  --&PBtnDisplay|[t width=100%]
  --%PDisplay|foreach;PlayerArray
    --&BtnColor|
    --&thisID|[&PDisplay(after,|)]
    --?"[&StoredList]" -inc "[&thisID]"|[
      --&BtnColor|style="background-color:#228B22;"
    --]|
    --&PBtnDisplay|+[tr][td [&BtnColor]][rbutton][&PDisplay(before,|)]::WriteContacts;[&PDisplay(after,|)][/rbutton][/td][/tr]
