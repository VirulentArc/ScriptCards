--:AssignContacts|
  --&CommsID|[&reentryval]
  --:BacktoContacts|
  --&Comms|[*[&CommsID]:character_name]
  --&CommsName|[&Comms(replace,comms-,)]
  --&StoredList|[*[&CommsID]:contact_list]
