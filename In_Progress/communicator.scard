  --&PBtnDisplay|+[/t]
  --+|[&PBtnDisplay]
  --+|NPC Contacts
  --&NBtnDisplay|[t width=100%]
  --%NDisplay|foreach;NPCArray
    --&BtnColor|
    --&thisID|[&NDisplay(after,|)]
    --?"[&StoredList]" -inc "[&thisID]"|[
      --&BtnColor|style="background-color:#228B22;"
    --]|
    --&NBtnDisplay|+[tr][td [&BtnColor]][rbutton][&NDisplay(before,|)]::WriteContacts;[&NDisplay(after,|)][/rbutton][/td][/tr]
  --%|
  --&NBtnDisplay|+[/t]
  --+|[&NBtnDisplay]
--X|
--:SetAttr|
  --&Setting|[&reentryval]
  --?"[&Setting]" -eq "sound" -or "[&Setting]" -eq "vibrate" -or "[&Setting]" -eq "silent"|[
    --!a:[&CommsID]|!alertsound:[&Setting]
  --]|
  --?"[&Setting]" -eq "strong" -or "[&Setting]" -eq "weak" -or "[&Setting]" -eq "none"|[
    --!a:[&CommsID]|!signal:[&Setting]
  --]|
  --?"[&Setting]" -eq "emergtoggle"|[
    --~|array;objects:character;AllComms;comms
    --%ThisComm|foreach;AllComms
      --&CurrentState|[*[&ThisComm]:emergtoggle]
      --?"[&CurrentState]" -eq "0"|&EmergToggle;1|&EmergToggle;0
      --!a:[&ThisComm]|!emergtoggle:[&EmergToggle]
    --%|
  --]|
  --?"[&Setting]" -eq "emergtoggle"|GMPanel
  --^BacktoSettings|
