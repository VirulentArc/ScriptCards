--+|[rbutton]Missed Calls::ContactsList[/rbutton]

--X|
--:GMPanel|
  --#title|GM Settings Panel
  --&CommsID|
  --+|Select a Player's Communicator
  --%CharLoop|foreach;AllComms
    --&CharName|[*[&CharLoop]:character_name]
