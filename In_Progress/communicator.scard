--:WriteContacts|
  --&ContactID|[&reentryval]
  --&CurrentList|[*[&CommsID]:contact_list]
  --?"[&CurrentList]" -inc "[&ContactID]"|[
    --&NewList|[&CurrentList(replace,[&ContactID]!#!,)]
  --]|[
    --&NewList|[&CurrentList][&ContactID]!#!
  --]|
  --&NewList|[&NewList(replaceall,undefined,)]
  --!a:[&CommsID]|!contact_list:[&NewList]
  --^BacktoContacts|
--X|
--:SetEmergencyMessage|
  --I. ;Click to Input Emergency Message|q;EMessage;What is the emergency message?
