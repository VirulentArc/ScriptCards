--<|
--:SpellBlock|
  --+|[t width=100% [&FullWidthStyle]][tr][td [&NPCNameStyle]][&NPC_Name] Spells[/td][/tr][/t]
  --+|[&Divider]
  --~|array;define;SpellLevels;cantrip;1;2;3;4;5;6;7;8;9
  --%LevelLoop|foreach;SpellLevels
    --&SpellIndex|0
    --Rfirst|[&CharID];repeating_spell-[&LevelLoop];spellname
    --?"[*R:spellname]" -eq "NoRepeatingAttributeLoaded"|NextLevel
    --?"[&LevelLoop]" -ne "cantrip"|&LvlName;Level [&LevelLoop]|&LvlName;[&LevelLoop(totitlecase)]
    --+|[t width=100% [&HRStyle]][&TightRuleSpacer][tr][td][&LvlName][/td][/tr][&TightRuleSpacer][/t]
    --%SpellLoop|while;"[*R:spellname]" -ne "NoRepeatingAttributeLoaded"
      --&CastSpell| --&SpellDesc| --&ToolComponents| --&SpellOutput|[*R:spelloutput]
      --&SpellSchool|[*R:spellschool] --&SpellTarget|[*R:spelltarget] --&SpellDescription|[*R:spelldescription] --&CleanedText|[&SpellDescription] -->CleanText| --&SpellDescription|[&CleanedText]
      --&Innate|[*R:innate] --&SpellHigherLevels|[*R:spellathigherlevels]
      --?"[&SpellTarget]" -ne "undefined" -and "[&SpellTarget]" -ne ""|[ --&CleanedText|[&SpellTarget] -->CleanText| --&SpellTarget|[&CleanedText] --]|
      --?"[&Innate]" -ne ""|[ --&CleanedText|[&Innate] -->CleanText| --&Innate|[&CleanedText] --]|
      --?"[&SpellHigherLevels]" -ne "undefined" -and "[&SpellHigherLevels]" -ne ""|[ --&CleanedText|[&SpellHigherLevels] -->CleanText| --&SpellHigherLevels|[&CleanedText] --]|
      --&ToolTip|[&SpellSchool(totitlecase)]&nbsp;&#x2666;&nbsp;CASTING&nbsp;TIME:&nbsp;[*R:spellcastingtime]&nbsp;&#x2666;&nbsp;RANGE:&nbsp;[*R:spellrange]
      --?"[&SpellTarget]" -ne "undefined" -and "[&SpellTarget]" -ne ""|[ --&ToolTip|+&nbsp;&#x2666;&nbsp;TARGET:&nbsp;[&SpellTarget] --]|
      --?"[*R:spellcomp_v]" -ne "0"|&ToolComponents;+V --?"[*R:spellcomp_s]" -ne "0"|&ToolComponents;+,S --?"[*R:spellcomp_m]" -ne "0"|[ --&CleanedText|[*R:spellcomp_materials] -->CleanText| --&ToolComponents|+,M([&CleanedText]) --]|
      --?"[&ToolComponents(0,1)]" -eq ","|&ToolComponents;[&ToolComponents(1)]
      --?"[&ToolComponents]" -ne ""|[ --&ToolTip|+&nbsp;&#x2666;&nbsp;[&ToolComponents] --]|
      --?"[*R:spellritual]" -eq "Yes"|[ --&ToolTip|+&nbsp;&#x2666;&nbsp;(r) --]|
      --?"[*R:spellconcentration]" -inc "1"|[ --&ToolTip|+&nbsp;&#x2666;&nbsp;(c) --]|
      --&ToolTip|+&nbsp;&#x2666;&nbsp;DURATION:&nbsp;[*R:spellduration]
      --?"[&Innate]" -ne ""|[ --&ToolTip|+&nbsp;&#x2666;&nbsp;[&Innate] --]|
      --&ToolTip|+&nbsp;&#x2666;&nbsp;[&SpellDescription]
      --?"[&SpellHigherLevels]" -ne "undefined" -and "[&SpellHigherLevels]" -ne ""|[ --&ToolTip|+&nbsp;&#x2666;&nbsp;AT HIGHER LEVELS: [&SpellHigherLevels] --]|
      --&CleanedText|[&ToolTip] -->CleanText| --&ToolTip|[&CleanedText]
      --?"[&SpellOutput]" -inc "ATTACK"|[ --&CastSpell|[td title="Cast Spell" [&RightButtonCell]][sheetbutton][F::18]&#x2694;[/F]::[*S:character_name]::repeating_spell-[&LevelLoop]_$[&SpellIndex]_spell[/sheetbutton][/td] --]|
      --?"[&SpellOutput]" -inc "ATTACK" -or "[&SpellOutput]" -inc "SPELLCARD"|[ --&SpellDesc|[td title="Description" [&RightButtonCell]][sheetbutton][F::14]&#128220;&#65038;[/F]::[*S:character_name]::repeating_spell-[&LevelLoop]_$[&SpellIndex]_output[/sheetbutton][/td] --]|
      --+|[t width=100%][tr][td title="[&ToolTip]" [&ClipCellStyle]][#000][b][i][*R:spellname].[/i][/b] [&SpellDescription][/#][/td][&CastSpell][&SpellDesc][/tr][/t]
      --&SpellIndex|[= [&SpellIndex] + 1 ]
