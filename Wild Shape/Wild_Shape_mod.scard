  --:AppendFormSection|
    --&FormSectionLabel|[%2%]
    --Rfirst|[&BeastID];[%1%]
    --&FormRowName|[*R:name]
    --?"[&FormRowName]" -eq "NoRepeatingAttributeLoaded"|[ --<| --]|
    --&SectionFirst|[&FormSectionLabel(0,1)]
    --&SectionRest|[&FormSectionLabel(1,99)]
    --&CardBody|+[t style="width:100%;line-height:1.1em;table-layout:fixed;border-collapse:separate;border-spacing:0 1px;"]
    --?"[%1%]" -ne "repeating_npctrait"|[ --&CardBody|+[tr][td colspan=2 style="[&SectionHeadCSS]"][F::20][&SectionFirst][/F][F::15][&SectionRest(touppercase)][/F][/td][/tr][tr][td colspan=2 style="height:2px;line-height:2px;font-size:1px;padding:0;border:0;background:transparent;"]&nbsp;[/td][/tr] --]|
    --&FormRowIndex|0
    --&ActionPending|0
    --&PendingAction|
    --%FormSectionLoop|while;"[&FormRowName]" -ne "NoRepeatingAttributeLoaded" -and "[&FormRowIndex]" -lt "100"
