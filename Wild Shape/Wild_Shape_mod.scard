  --:BuildFXGrid|options;selected;mode
    --~|array;fromstring;FXOptions;,;[%1%]
    --&FXButtons|[t style="width:100%;text-align:center;table-layout:fixed;border-collapse:separate;border-spacing:3px 2px;[&BodyStyle]"][tr]
    --=FXGridCount|0
    --%FXGridLoop|foreach;FXOptions
      --?"[= [$FXGridCount.Raw] % 3 ]" -eq "0" -and "[$FXGridCount.Raw]" -ne "0"|[ --&FXButtons|+[/tr][tr] --]|
      --&FXButtonBG|[&ManagerButtonOffBG]
      --?"[&FXGridLoop]" -eq "[%2%]"|[ --&FXButtonBG|[&ManagerButtonOnBG] --]|
