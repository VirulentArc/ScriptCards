        --&FormActionIcon|&#x1F5CE;&#65038;
        --&FormActionButton|[button:14PX][&FormActionIcon]::~[&BeastID]|[&LegacyButtonURL][/button]
      --]|
      --?"[&Beacon]" -ne "1" -and "[%1%]" -ne "repeating_npctrait"|[
