  --:SaveFX|
    --?"[&IsGM]" -eq "1" -and "[&GMView]" -eq "1"|GMEntry
    --?"[&OriginalPlayerID]" -ne "[&SendingPlayerID]"|Unauthorized
    -->LoadState|
    --~FXData|string;split;|;[&reentryval]
    --?"[&FXData1]" -eq "Default"|[ --&FXType|Default --&FXColor| --]|
    --?"[&FXData1]" -eq "None"|[ --&FXType| --&FXColor| --]|
    --?"[&FXData1]" -eq "Type"|[ --&FXType|[&FXData2] --?"[&FXColor]" -eq "" -or "[&FXColor]" -eq "undefined"|&FXColor;smoke --]|
    --?"[&FXData1]" -eq "Color"|[ --&FXColor|[&FXData2] --?"[&FXType]" -eq "" -or "[&FXType]" -eq "undefined" -or "[&FXType]" -eq "Default"|&FXType;explode --]|
    -->WriteState|
    --^FXSettingsStateLoaded|
  --:Transform|
    --?"[&IsGM]" -eq "1" -and "[&GMView]" -eq "1"|GMEntry
    --?"[&OriginalPlayerID]" -ne "[&SendingPlayerID]"|Unauthorized
    --&RequestedFormID|[&reentryval]
    --?"[&RequestedFormID]" -eq "" -or "[&RequestedFormID]" -eq "undefined"|ChooseForm
    -->LoadAssignedForms|
    --?"[&AssignedRaw]" -ninc ",[&RequestedFormID],"|FormNotAssigned
