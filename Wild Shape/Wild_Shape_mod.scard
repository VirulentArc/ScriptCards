  --:GMNoDruids|
    --&ErrorMode|GM_NONE --&ErrorMessage|No player character with Druid levels was found in the game. --^ErrorCard|
  --:GMPlayerModeNeedsDruid|
    --&GMView|1
    -->WriteGlobalSettings|
    --^GMEntry|
  --:NoSelectedToken|
    --&ErrorMode|NONE --&ErrorMessage|[b]No Token Selected[/b][br]Select the character token before running Wild Shape. --^ErrorCard|
  --:MultipleSelectedTokens|
    --&ErrorMode|NONE --&ErrorMessage|[b]Multiple Tokens Selected[/b][br]Select only one character token before running Wild Shape. --^ErrorCard|
  --:NoCharacter|
    --&ErrorMode|NONE --&ErrorMessage|[b]No Character Sheet[/b][br]The selected token must represent the character using Wild Shape. --^ErrorCard|
  --:PlayerNotDruid|
