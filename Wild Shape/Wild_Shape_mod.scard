      --]|
      --?"[&ActionPending]" -eq "1"|[
        --&CardBody|+[tr][&PendingAction][td title="[&FormRowName]" style="[&ActionPairCellCSS]padding:0 0 0 3px;text-align:right;"][t style="display:inline-table;float:left;margin:0;height:18px;line-height:18px;vertical-align:middle;"][tr][td style="height:18px;line-height:18px;padding:0;border:0;background:transparent;vertical-align:middle;text-align:center;"]&#8226;[/td][/tr][/t][t style="display:inline-table;line-height:18px;vertical-align:middle;position:relative;z-index:2;float:left;margin:0 3px 0 6px;border-collapse:separate;border-spacing:0;"][tr][td style="[&CompactButtonCellCSS]width:22px;height:10px;line-height:10px;"][&FormActionButton][/td][/tr][/t][b][i][&FormRowName].[/i][/b][/td][/tr]
        --&PendingAction|
        --&ActionPending|0
      --]|[
        --&PendingAction|[td title="[&FormRowName]" style="[&ActionPairCellCSS]padding:0 3px 0 0;text-align:left;"][t style="display:inline-table;line-height:18px;vertical-align:middle;position:relative;z-index:2;float:right;margin:0 0 0 3px;border-collapse:separate;border-spacing:0;"][tr][td style="[&CompactButtonCellCSS]width:22px;height:10px;line-height:10px;"][&FormActionButton][/td][/tr][/t][b][i][&FormRowName].[/i][/b][/td]
        --&ActionPending|1
      --]|
      --:FormSectionNext|
      --&FormRowIndex|[= [&FormRowIndex] + 1 ]
      --Rnext|
      --&FormRowName|[*R:name]
    --%|
    --?"[&ActionPending]" -eq "1"|[ --&CardBody|+[tr][&PendingAction][td style="width:50%;padding:0;"][/td][/tr] --]|
    --&CardBody|+[/t]
  --<|
