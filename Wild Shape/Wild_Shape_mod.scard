    --]|
    --&CardBody|+[t style="width:105px;margin:0 auto;table-layout:fixed;[&BodyStyle]"][tr][td style="[&ButtonCellCSS][&GMViewButtonBG]"][rbutton]DM View: [&GMViewDisplay]::ToggleGMView[/rbutton][/td][/tr][/t]
