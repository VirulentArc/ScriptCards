    --&FXDefaultBG|[&ManagerButtonOffBG]
    --&FXNoneBG|[&ManagerButtonOffBG]
    --?"[&FXType]" -eq "Default"|[ --&FXDefaultBG|[&ManagerButtonOnBG] --]|
    --?"[&FXType]" -eq "" -and "[&FXColor]" -eq ""|[ --&FXNoneBG|[&ManagerButtonOnBG] --]|
    --&CardBody|+[t style="width:220px;margin:0 auto;table-layout:fixed;border-collapse:separate;border-spacing:5px 2px;[&BodyStyle]"][tr][td style="width:105px;[&ButtonCellCSS][&FXDefaultBG]"][rbutton]Default FX::SaveFX;Default|[/rbutton][/td][td style="width:105px;[&ButtonCellCSS][&FXNoneBG]"][rbutton]No FX::SaveFX;None|[/rbutton][/td][/tr][/t]
    --&CardBody|+[&ControlDivider][t style="width:100%;table-layout:fixed;[&BodyStyle]"][tr][td style="text-align:center;font-variant:small-caps;font-size:15px;font-weight:bold;"]Effect Type[/td][/tr][/t]
    -->BuildFXGrid|bomb,breath,bubbling,burn,burst,explode,glow,nova,splatter;[&FXType];Type
