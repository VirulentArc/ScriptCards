    --?"[&LastFormID]" -ne "" -and "[&AssignedRaw]" -inc ",[&LastFormID],"|[ --&RequestedFormID|[&LastFormID] --^FormCard| --]|
    --&CardTitle|Wild Shape
    --&CardBody|[t style="width:100%;[&BodyStyle]"][tr][td style="font-size:14px;"][b][&DruidName][/b][/td][/tr][tr][td]Druid Level [&DruidLevel] &bull; [&Rules] Rules[/td][/tr][/t]
