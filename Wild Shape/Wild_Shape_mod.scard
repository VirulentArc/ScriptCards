    --?"[&ForceRevertTokenCheck]" -ne "" -and "[&ForceRevertTokenCheck]" -ne "undefined"|&ForceRevertTokenFound;1
    --?"[&ForceRevertOriginalTokenCheck]" -ne "" -and "[&ForceRevertOriginalTokenCheck]" -ne "undefined"|&ForceRevertOriginalTokenFound;1
    --&ForceRevertMessage|This will replace the recorded transformed token with [&DruidName]'s original token and clear the active Wild Shape state.
    --?"[&ForceRevertOriginalTokenFound]" -eq "1"|[ --&ForceRevertMessage|This will restore [&DruidName]'s preserved original token and clear the active Wild Shape state. --]|
    --?"[&ForceRevertTokenFound]" -eq "0" -and "[&ForceRevertOriginalTokenFound]" -eq "0"|[ --&ForceRevertMessage|The recorded transformed token no longer exists. This will clear the stale Wild Shape state without creating or deleting a token. --]|
    --&CardTitle|Force Wild Shape Revert
    --&CardBody|[t style="width:100%;[&BodyStyle]"][tr][td style="text-align:center;white-space:normal;"][b][&DruidName][/b][br][&ForceRevertMessage][/td][/tr][/t]
    --&CardBody|+[&ControlDivider][t style="[&FooterControlTableStyle][&BodyStyle]"][tr][td style="width:[&FooterControlCellWidth][&ButtonCellCSS][&ManagerButtonOnBG]"][rbutton]Confirm Revert::GMForceRevert[/rbutton][/td][td style="width:[&FooterControlCellWidth][&ButtonCellCSS]"][rbutton]Cancel::GMSettings[/rbutton][/td][/tr][/t]
    -->RenderCard|
    --X|
  --:GMForceRevert|
    --?"[&OriginalPlayerID]" -ne "[&SendingPlayerID]" -or "[&IsGM]" -ne "1" -or "[&GMView]" -ne "1"|Unauthorized
    -->LoadState|
    -->LoadDruidRules|
    --?"[&ActiveFormID]" -eq ""|GMNoActiveWildShape
    --&ForceRevertMode|1
