  --:GMSettingsRender|
    --&CardTitle|Wild Shape DM Settings
    --&TitleStyle|style="font-family:Georgia,'Noto Serif','Liberation Serif','Nimbus Roman No9 L','Nimbus Roman','DejaVu Serif','Times New Roman',serif;font-variant:small-caps;font-size:19px;font-weight:bold;color:#7A2008;line-height:1.05em;white-space:nowrap;"
    --?"[&Rules]" -eq "2024"|[ --&TitleStyle|style="font-family:Georgia,'Noto Serif','Liberation Serif','Nimbus Roman No9 L','Nimbus Roman','DejaVu Serif','Times New Roman',serif;font-variant:small-caps;font-size:19px;font-weight:bold;line-height:1.05em;letter-spacing:0;white-space:nowrap;" --]|
    --&NonBeastDisplay|Off
    --?"[&AllowNonBeast]" -eq "1"|[ --&NonBeastDisplay|On --]|
    --&CardBody|[t style="width:100%;[&BodyStyle]"][tr][td style="text-align:center;font-size:14px;font-weight:bold;"][&DruidName][/td][/tr][tr][td style="text-align:center;"]Druid [&DruidLevel] &bull; [&Rules] Rules &bull; Assigned Forms [$AssignedCount.Raw][/td][/tr][/t]
    --&CardBody|+[&ControlDivider]
    --?"[&ActiveFormID]" -eq ""|[
      --&CardBody|+[t style="width:220px;margin:0 auto;table-layout:fixed;border-collapse:separate;border-spacing:0;[&BodyStyle]"][tr][td style="[&ButtonCellCSS]"][rbutton]Manage Wild Shape Forms::ManageForms;START[/rbutton][/td][/tr][/t]
    --]|[
      --&CardBody|+[t style="[&FooterControlTableStyle][&BodyStyle]"][tr][td style="width:[&FooterControlCellWidth][&ButtonCellCSS]"][rbutton]Manage Forms::ManageForms;START[/rbutton][/td][td style="width:[&FooterControlCellWidth][&ButtonCellCSS][&ManagerButtonOnBG]"][rbutton]Force Revert::GMForceRevertPrompt[/rbutton][/td][/tr][/t]
    --]|
    --&CardBody|+[&ControlDivider]
    --&CardBody|+[t style="width:100%;[&BodyStyle]"][tr][td style="text-align:center;font-size:9px;line-height:11px;font-weight:bold;letter-spacing:.7px;"]GLOBAL RULES[/td][/tr][/t]
    --&CardBody|+[t style="[&FooterControlTableStyle][&BodyStyle]"][tr][td style="width:[&FooterControlCellWidth][&ButtonCellCSS]"][rbutton]Rules: [&Rules]::ToggleRules[/rbutton][/td][td style="width:[&FooterControlCellWidth][&ButtonCellCSS]"][rbutton]Non-Beasts: [&NonBeastDisplay]::ToggleNonBeast[/rbutton][/td][/tr][/t]
    --?[$DruidCount.Raw] -gt 1|[
      --&CardBody|+[&ControlDivider][t style="width:105px;margin:0 auto;table-layout:fixed;[&BodyStyle]"][tr][td style="[&ButtonCellCSS]"][rbutton]Choose Druid::GMEntry[/rbutton][/td][/tr][/t]
    --]|
    -->RenderCard|
