--:WriteSCA|
  --=SCAPB|[*[&CharId_Attr]:pb]
  --=SCAOldMod|[$SCAbility.Raw]
  --=SCAAttackExtra|[:SpellHeaderValueDB("spell_attack_bonus")] - [$SCAPB.Raw] - [$SCAOldMod.Raw]
  --=SCASaveExtra|[:SpellHeaderValueDB("spell_save_dc")] - 8 - [$SCAPB.Raw] - [$SCAOldMod.Raw]
  --=SCANewMod|[*[&CharId_Attr]:[&reentryval(tolowercase)]_mod]
  --=SAB|[$SCAPB.Raw] + [$SCANewMod.Raw] + [$SCAAttackExtra.Raw]
  --=SpellDC|8 + [$SCAPB.Raw] + [$SCANewMod.Raw] + [$SCASaveExtra.Raw]
  --&AT|@
  --!a:[&CharId_Attr]|!spellcasting_ability:[&AT]{[&reentryval(tolowercase)]_mod}+
  --!a:[&CharId_Attr]|!spell_attack_bonus:[$SAB.Raw]
  --!a:[&CharId_Attr]|!spell_save_dc:[$SpellDC.Raw]
  --^RestartBook|
--X|
