{
  "name": "scriptcards-syntax-highlighting-plus",
  "displayName": "ScriptCards Syntax Highlighting Plus",
  "description": "Syntax highlighting for Roll20 ScriptCards files, tuned for dark VS Code themes.",
  "version": "1.0.0",
  "publisher": "Tim Beasley",
  "author": "Tim Beasley",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/VirulentArc/scriptcards-syntax-highlighting-plus.git"
  },
  "engines": {
    "vscode": "^1.67.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "scriptcards",
    "roll20",
    "syntax",
    "highlighting",
    "vscode"
  ],
  "contributes": {
    "languages": [
      {
        "id": "scriptcards-plus",
        "aliases": [
          "ScriptCards Plus",
          "Roll20 ScriptCards Plus",
          "scriptcards-plus"
        ],
        "extensions": [
          ".scard",
          ".scard.txt",
          ".scriptcard",
          ".scriptcards"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "scriptcards-plus",
        "scopeName": "text.roll20-scriptcards-plus",
        "path": "./syntaxes/scriptcards.tmLanguage.json"
      }
    ],
    "configurationDefaults": {
      "files.associations": {
        "*.scard": "scriptcards-plus",
        "*.scard.txt": "scriptcards-plus",
        "*.scriptcard": "scriptcards-plus",
        "*.scriptcards": "scriptcards-plus"
      },
      "editor.tokenColorCustomizations": {
        "textMateRules": [
          {
            "scope": "support.variable.property.loopname.scriptcards",
            "settings": {
              "foreground": "#00E5FF"
            }
          },
          {
            "scope": "variable.other.readwrite.loopname.scriptcards, variable.other.loop.name.scriptcards, entity.name.type.loop.scriptcards",
            "settings": {
              "foreground": "#00E5FF"
            }
          }
        ]
      }
    }
  }
}
